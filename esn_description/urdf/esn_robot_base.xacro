<?xml version="1.0"?>
<robot name="esn_robot_macros" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====== Materiali (definiti una sola volta, fuori dalla macro) ====== -->
  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
  <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="light_black"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="green"><color rgba="0.0 0.8 0.0 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.4235 0.0392 1.0"/></material>
  <material name="brown"><color rgba="0.8706 0.8118 0.7647 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="white"><color rgba="1.0 1.0 1.0 1.0"/></material>

  <!--
    Macro principale:
      - prefix: per evitare collisioni (es. "r1_")
      - scanner_xyz / scanner_rpy: posa del supporto laser (solo il supporto, NIENTE scanner)
  -->
  <xacro:macro name="esn_robot" params="prefix:=''">

    <!-- ====== base_footprint / base_link + ruote + caster + IMU (come nel tuo URDF) ====== -->
    <link name="${prefix}base_footprint"/>

    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${prefix}base_footprint"/>
      <child  link="${prefix}base_link"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}base_link">
      <!-- Visual / Collision: box (niente mesh), scala 1.5× -->
      <visual>
        <origin xyz="-0.096 0 0.0705" rpy="0 0 0"/>
        <geometry><box size="0.399 0.399 0.141"/></geometry>
        <material name="light_black"/>
      </visual>
      <collision>
        <origin xyz="-0.096 0 0.0705" rpy="0 0 0"/>
        <geometry><box size="0.399 0.399 0.141"/></geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="4.633569900"/>
        <inertia ixx="0.066067688981" ixy="-0.000361284677" ixz="0.000847500393"
                 iyy="0.065454645544" iyz="-0.000026898808"
                 izz="0.110965395656" />
      </inertial>
    </link>

    <!-- Ruota sinistra -->
    <joint name="${prefix}wheel_left_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}wheel_left_link"/>
      <origin xyz="0.0 0.216 0.0345" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}wheel_left_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="0.027" radius="0.0495"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="0.027" radius="0.0495"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.096183923" />
        <inertia ixx="8.486456062500e-05" ixy="-3.217455396563e-10" ixz="-4.509299286562e-08"
                 iyy="8.499238621875e-05" iyz="-1.093508125313e-10"
                 izz="1.572859873125e-04" />
      </inertial>
    </link>

    <!-- Ruota destra -->
    <joint name="${prefix}wheel_right_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}wheel_right_link"/>
      <origin xyz="0.0 -0.216 0.0345" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}wheel_right_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="0.027" radius="0.0495"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="0.027" radius="0.0495"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.096183923" />
        <inertia ixx="8.486456062500e-05" ixy="-3.217455396563e-10" ixz="-4.509299286562e-08"
                 iyy="8.499238621875e-05" iyz="-1.093508125313e-10"
                 izz="1.572859873125e-04" />
      </inertial>
    </link>

    <!-- Caster posteriore destro -->
    <joint name="${prefix}caster_back_right_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}caster_back_right_link"/>
      <origin xyz="-0.2655 -0.096 -0.006" rpy="-1.57 0 0"/>
    </joint>

    <link name="${prefix}caster_back_right_link">
      <visual>
        <origin xyz="0 0.0015 0" rpy="0 0 0"/>
        <geometry><box size="0.045 0.0135 0.03"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0.0015 0" rpy="0 0 0"/>
        <geometry><box size="0.045 0.0135 0.03"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.016875000" />
        <inertia ixx="0.00759375" ixy="0.0" ixz="0.0"
                 iyy="0.00759375" iyz="0.0"
                 izz="0.00759375" />
      </inertial>
    </link>

    <!-- Caster posteriore sinistro -->
    <joint name="${prefix}caster_back_left_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child  link="${prefix}caster_back_left_link"/>
      <origin xyz="-0.2655 0.096 -0.006" rpy="-1.57 0 0"/>
    </joint>

    <link name="${prefix}caster_back_left_link">
      <visual>
        <origin xyz="0 0.0015 0" rpy="0 0 0"/>
        <geometry><box size="0.045 0.0135 0.03"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0.0015 0" rpy="0 0 0"/>
        <geometry><box size="0.045 0.0135 0.03"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.016875000" />
        <inertia ixx="0.00759375" ixy="0.0" ixz="0.0"
                 iyy="0.00759375" iyz="0.0"
                 izz="0.00759375" />
      </inertial>
    </link>
  </xacro:macro>

</robot>
