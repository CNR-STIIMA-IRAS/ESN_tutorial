<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="esn_ros2_control" params="use_fake_hardware:=true name:=esn_robot prefix:='' master_id:=0">

    <ros2_control name="${name}_left" type="system">
      <hardware>
        <!-- A prescindere questo giunto è simulato -->
        <plugin>mock_components/GenericSystem</plugin>
        <param name="mock_sensor_commands">true</param>
        <param name="calculate_dynamics">true</param>
      </hardware>

      <joint name="${prefix}wheel_left_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>

    <ros2_control name="${name}_right" type="system">
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">true</param>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <!-- Caso con hardware reale: ETHERCAT -->
        <xacro:unless value="${use_fake_hardware}">
          <plugin>ethercat_driver/EthercatDriver</plugin>
          <param name="master_id">${master_id}</param>
          <param name="control_frequency">100</param>
        </xacro:unless>
      </hardware>

        <joint name="${prefix}wheel_right_joint">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="reset_fault"/>
          <command_interface name="control_word"/>
          <command_interface name="mode_of_operation"/>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
          <!-- <state_interface name="effort">
            <param name="initial_value">0.0</param>
          </state_interface> -->
          <state_interface name="mode_of_operation"/>
          <state_interface name="status_word"/>
          <xacro:unless value="${use_fake_hardware}">
            <ec_module name="${prefix}wheel_right_joint">
              <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
              <param name="alias">0</param>
              <param name="position">1</param>
              <param name="mode_of_operation">9</param> 
              <!-- <param name="slave_config">$(find esn_description)/config/ethercat/EL7201_ethercat_config.yaml</param> -->

              <param name="slave_config">$(find esn_description)/config/ethercat/el7211_config.yaml</param>
            </ec_module>
          </xacro:unless>
        </joint>
    </ros2_control>
  </xacro:macro>

</robot>